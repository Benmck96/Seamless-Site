    blurbJa: '工場仕上げの Fascia Post を、芯までソリッドで。',
  },
  {
    name: 'Seamless Cedar Timbers',
    construction: 'Hollow',
    tag: 'Full-sawn cedar',
    tagJa: 'フルソーン・シーダー',
    href: '/products/seamless-cedar-timbers',
    sizes: '6×6 · 8×8',
    finishes: 'S4S · Rougher Head · Resawn',
    colors: 'Natural WRC',
    colorsJa: 'ナチュラル WRC',
    blurb: 'Coastal Western Red Cedar appearance with hollow-core stability.',
    blurbJa: '沿岸産ウエスタンレッドシーダーの外観と、中空構造の安定性。',
  },
  {
    name: 'Seamless-Solid Cedar Timbers',
    construction: 'Solid',
    tag: 'Solid laminated',
    tagJa: 'ソリッド積層',
    href: '/products/seamless-solid-cedar-timbers',
    sizes: '4×4 · 6×6 · 8×8',
    finishes: 'S4S · Rougher Head · Resawn',
    colors: 'Natural WRC',
    colorsJa: 'ナチュラル WRC',
    blurb: 'Coastal Western Red Cedar faces on a full solid section.',
    blurbJa: '沿岸産ウエスタンレッドシーダーの表面を、芯まで詰まったソリッド断面で。',
  },
  {
    name: 'Seamless Treated',
    construction: 'Hollow',
    tag: 'Ground-contact',
    tagJa: '地面接触用',
    href: '/products/seamless-treated',
    sizes: '6×6 · 8×8',
    finishes: 'S4S · Rougher Head · Resawn',
    colors: 'Treated',
    colorsJa: '防腐処理色',
    blurb: 'Pressure-treated for ground contact and exterior longevity.',
    blurbJa: '地面接触用途と屋外での耐久性のための加圧注入処理。',
  },
  {
    name: 'Seamless-Solid Treated',
    construction: 'Solid',
    tag: 'Solid laminated',
    tagJa: 'ソリッド積層',
    href: '/products/seamless-solid-treated',
    sizes: '4×4 · 4×6 · 6×6 · 4×8 · 8×8',
    finishes: 'S4S · Rougher Head · Resawn',
    colors: 'Treated',
    colorsJa: '防腐処理色',
    blurb: 'Pressure-treated for ground contact, built as a solid section.',
    blurbJa: '地面接触用の加圧注入処理を、ソリッド断面で。',
  },
  {
    name: 'Timber-Lite Douglas-fir',
    construction: 'Hollow',
    tag: 'Sibling line',
    tagJa: '姉妹ライン',
    href: '/products/timber-lite-doug-fir',
    sizes: '6×6 · 8×8',
    finishes: 'S4S · Resawn · Rougher Head',
    colors: 'Natural Douglas-fir',
    colorsJa: 'ナチュラル ダグラスファー',
    blurb: 'Douglas-fir engineered timbers for structural-look applications.',
    blurbJa: '構造材の見た目を活かす用途向けの、ダグラスファーのエンジニアード材。',
  },
  {
    name: 'Seamless-Solid KD Douglas-fir',
    construction: 'Solid',
    tag: 'Kiln dried',
    tagJa: '人工乾燥',
    href: '/products/seamless-solid-kd-doug-fir',
    sizes: '4×4 · 6×6 · 8×8',
    finishes: 'S4S · Resawn · Rougher Head',
