    blurbJa: '現場での柱の化粧巻きは、もう要りません。一本で、上質な仕上がりを。',
  },
  {
    name: 'Seamless-Solid Fascia Post',
    construction: 'Solid',
    tag: 'Solid laminated',
    tagJa: 'ソリッド積層',
    href: '/products/seamless-solid-fascia-post',
    sizes: '4×4 · 4×6 · 6×6 · 8×8',
    finishes: 'S4S · Combed · Resawn',
    colors: 'Grey · Cedar-Brown',
    colorsJa: 'グレー · シダーブラウン',
