// From the catalogue's "One collection. Three constructions." page
const constructions = [
  {
    n: '01', name: 'Hollow-Core', nameJa: '中空構造', image: '/images/constructions/hollow-core.jpg',
    body: 'The look and strength of a solid sawn timber with less weight, improved stability, and a seamless finished appearance.',
    bodyJa: '無垢の製材品の見た目と強度を、より軽く、より安定した、継ぎ目のない仕上がりで。',
    use: 'Structural and appearance posts for vertical applications',
    useJa: '柱用途の構造材・化粧柱',
  },
  {
    n: '02', name: 'Solid Laminated', nameJa: 'ソリッド積層', image: '/images/constructions/solid-laminated.jpg',
    body: 'Solid wood performance with engineered stability — built to be stable and more consistent than conventional solid-sawn posts.',
    bodyJa: '無垢材の性能に、エンジニアリングによる安定性を。一般的な無垢の製材柱より安定し、品質が揃います。',
    use: 'Structural and appearance posts where a solid section or enhanced fire performance is preferred',
    useJa: 'ソリッド断面や高い耐火性能が求められる構造材・化粧柱',
  },
  {
    n: '03', name: 'FJ Edge-Glued', nameJa: 'FJ 幅はぎ材', image: '/images/constructions/fj-edge-glued.jpg',
    body: 'Long, straight boards engineered for a consistent appearance, reliable dimensions and efficient installation.',
    bodyJa: '均一な外観、確かな寸法、効率的な施工のために設計された、長く真っすぐなボード。',
    use: 'Fascia, trim, siding and beam wraps',
    useJa: '鼻隠し、トリム、サイディング、梁の化粧巻き',
  },
];
---

<Base title="Products — Seamless™ Engineered Timbers" titleJa="製品一覧 — Seamless™ エンジニアード木材">
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-12">
    <div class="eyebrow mb-4"><T en="Products" ja="製品" /></div>
    <h1 class="text-5xl md:text-6xl font-medium tracking-tighter-2 max-w-3xl mb-6">
      <T
        en='One collection. <span class="italic text-cedar">Three constructions.</span>'
        ja='ひとつのコレクション。<span class="italic text-cedar">3つの構造。</span>'
      />
    </h1>
    <p class="text-lg text-smoke max-w-2xl mb-8">
      <T
        en="Three engineered constructions, each designed to deliver the right balance of strength, stability, appearance and value for the application."
        ja="強度、安定性、外観、価格のバランスを用途に合わせて最適化した、3つのエンジニアード構造。"
      />
    </p>
    <a href="/docs/seamless-catalogue-nov2026.pdf" target="_blank" rel="noopener" class="btn-secondary">
      <T en="Download the catalogue (PDF, 3 MB) →" ja="カタログをダウンロード（英語・PDF 3MB）→" />
    </a>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-16 grid md:grid-cols-3 gap-6">
    {constructions.map((c) => (
      <div class="border border-line flex flex-col">
        <div class="bg-white border-b border-line" style="aspect-ratio: 1/1;">
          <img src={c.image} alt={c.name} class="w-full h-full object-contain" loading="lazy" />
        </div>
        <div class="p-6 flex flex-col flex-1">
          <div class="eyebrow text-cedar mb-2"><T en={`Construction ${c.n}`} ja={`構造 ${c.n}`} /></div>
          <h2 class="text-2xl font-medium tracking-tighter-2 mb-3"><T en={c.name} ja={c.nameJa} /></h2>
          <p class="text-smoke leading-relaxed mb-6"><T en={c.body} ja={c.bodyJa} /></p>
          <div class="mt-auto border-t border-line pt-4">
            <div class="eyebrow text-ash mb-1"><T en="Use for" ja="主な用途" /></div>
            <p class="text-sm"><T en={c.use} ja={c.useJa} /></p>
          </div>
        </div>
      </div>
    ))}
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-6">
    <div class="eyebrow"><T en="All products" ja="すべての製品" /></div>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-24 grid md:grid-cols-2 gap-6">
    {products.map((p) => (
      <a href={p.href} class="block border border-line p-8 hover:border-ink transition-colors group">
        <div class="flex justify-between items-start gap-4 mb-6">
          <div>
            <div class="eyebrow text-ash mb-1"><T en={p.construction} ja={optionJa[p.construction]} /></div>
            <h2 class="text-2xl font-medium tracking-tighter-2 group-hover:text-cedar transition-colors">
              {p.name}
            </h2>
          </div>
          <span class="eyebrow text-right"><T en={p.tag} ja={p.tagJa} /></span>
        </div>
        <p class="text-smoke mb-8 leading-relaxed"><T en={p.blurb} ja={p.blurbJa} /></p>
        <div class="grid grid-cols-3 gap-4 text-sm border-t border-line pt-4">
          <div>
            <div class="eyebrow mb-1"><T en="Sizes" ja="サイズ" /></div>
            <div>{p.sizes}</div>
          </div>
          <div>
            <div class="eyebrow mb-1"><T en="Finishes" ja="仕上げ" /></div>
            <div>{p.finishes}</div>
          </div>
          <div>
            <div class="eyebrow mb-1"><T en="Colors" ja="カラー" /></div>
            <div><T en={p.colors} ja={p.colorsJa} /></div>
          </div>
        </div>
      </a>
    ))}
  </section>
</Base>
