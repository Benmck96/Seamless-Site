---
import fs from 'node:fs';
import path from 'node:path';
import T from './T.astro';
import { products } from '../data/products.js';
import { productsJa, optionJa } from '../data/products-ja.js';

export interface Props {
  product: {
    slug: string;
    imageFolder: string;
    pair?: string;
    name: string;
    sizes: string[];
    finishes: string[];
    finishEdges?: Record<string, string> | null;
    colors: string[];
    lengths: string;
    warranty?: string | null;
  };
}

const { product } = Astro.props;
const showColors = true;
const colorLabel = product.colors.length > 1 ? 'Color' : 'Species';
const colorLabelJa = product.colors.length > 1 ? 'カラー' : '樹種';
const opt = (v: string) => optionJa[v] ?? v;
const warrantyJa = productsJa[product.slug]?.warranty;
const isTimberLite = product.slug === 'timber-lite-doug-fir';
const accentClass = isTimberLite ? 'text-ink' : 'text-cedar';
const accentBg = isTimberLite ? 'bg-ink' : 'bg-cedar';

// Default edge per finish; a product can override with finishEdges, or set it
// to null for products with no edge detail (boards).
const FINISH_EDGE: Record<string, string> = product.finishEdges === null ? {} : {
  'S4S':         'Eased Edge (EE)',
  'Rougher Head': 'Square Edge (SQ)',
  'Resawn':      'Square Edge (SQ)',
  ...product.finishEdges,
};
const initialEdgeDetail = FINISH_EDGE[product.finishes[0]] ?? '';

// imageFolder is the short folder name (e.g. "fascia-post"), not the full slug.
// Photo naming: Size_Finish_Colour_1.png, _2.png, ... or Size_Finish_Colour.png
const photoBase = `/images/products/${product.imageFolder}/`;

// Photos that exist for this product, then for its Hollow/Solid twin — the
// page picks from these instead of guessing filenames in the browser.
function listPhotos(folder: string): string[] {
  const dir = path.join(process.cwd(), 'public', 'images', 'products', folder);
  return fs.existsSync(dir) ? fs.readdirSync(dir).filter((n) => /\.(jpe?g|png)$/i.test(n)) : [];
}
const twin = product.pair ? products[product.pair] : null;
const photoSets = [
  { base: photoBase, files: listPhotos(product.imageFolder) },
  ...(twin ? [{ base: `/images/products/${twin.imageFolder}/`, files: listPhotos(twin.imageFolder) }] : []),
];
---

<section class="bg-ink text-bone py-20">
  <div class="max-w-7xl mx-auto px-6">
    <div class="eyebrow text-ash mb-2"><T en="Configure" ja="仕様を選ぶ" /></div>
    <h2 class="text-3xl md:text-4xl font-medium tracking-tighter-2 mb-10">
      <T en="Pick your spec." ja="仕様をお選びください。" />
    </h2>

    <div
      id="product-config-data"
      class="hidden"
      data-photo-sets={JSON.stringify(photoSets)}
      data-edge-ja={JSON.stringify(Object.fromEntries(Object.values(FINISH_EDGE).map((e) => [e, opt(e)])))}
      data-finish-edges={JSON.stringify(FINISH_EDGE)}
      data-sizes={JSON.stringify(product.sizes)}
      data-finishes={JSON.stringify(product.finishes)}
      data-colors={JSON.stringify(product.colors)}
    ></div>

    <div class="grid md:grid-cols-5 gap-8 md:gap-12 items-stretch">

      {/* ── Photo panel — 3/5 of page width on desktop ── */}
      <div class="md:col-span-3">
        <div id="photo-container" class="relative overflow-hidden bg-[#ede9e2]" style="aspect-ratio: 1 / 1;">
          {/* Placeholder — visible until a photo loads */}
          <div id="photo-placeholder" class="absolute inset-0 flex items-center justify-center">
            <span class="text-[#a89f93] text-[10px] eyebrow tracking-widest"><T en="Photo coming soon" ja="写真は近日公開" /></span>
          </div>

          {/* Photo — crossfades on selection change, cycles through numbered shots */}
          <img
            id="product-photo"
            src=""
            alt={product.name}
            class="absolute inset-0 w-full h-full object-cover"
            style="opacity: 0; transition: opacity 0.45s ease;"
          />

          {/* Dot indicators — shown only when there are multiple shots */}
          <div id="photo-dots" class="absolute bottom-4 left-0 right-0 flex justify-center gap-2 hidden">
          </div>

        </div>
      </div>

      {/* ── Controls: Toggles + Spec — 2/5 of page width on desktop ── */}
      <div class="md:col-span-2 flex flex-col gap-8">

        {/* Toggles */}
        <div class="space-y-6">
          <div>
            <div class="eyebrow text-ash mb-3"><T en="Size" ja="サイズ" /></div>
            <div class="flex flex-wrap gap-2" data-config-group="size">
              {product.sizes.map((size, i) => (
                <button
                  type="button"
                  data-config-option={size}
                  class={`config-btn px-5 py-3 border text-sm font-medium transition-colors ${i === 0 ? 'is-active' : ''}`}
                >
                  {size.replace('x', '×')}
                </button>
              ))}
            </div>
          </div>

          <div>
            <div class="eyebrow text-ash mb-3"><T en="Finish" ja="仕上げ" /></div>
            <div class="flex flex-wrap gap-2" data-config-group="finish">
              {product.finishes.map((finish, i) => (
                <button
                  type="button"
                  data-config-option={finish}
                  class={`config-btn px-5 py-3 border text-sm font-medium transition-colors ${i === 0 ? 'is-active' : ''}`}
                >
                  <T en={finish} ja={opt(finish)} />
                </button>
              ))}
            </div>
          </div>

          {showColors && (
            <div>
              <div class="eyebrow text-ash mb-3"><T en={colorLabel} ja={colorLabelJa} /></div>
              <div class="flex flex-wrap gap-2" data-config-group="color">
                {product.colors.map((color, i) => (
                  <button
                    type="button"
                    data-config-option={color}
                    class={`config-btn px-5 py-3 border text-sm font-medium transition-colors ${i === 0 ? 'is-active' : ''}`}
                  >
                    <T en={color} ja={opt(color)} />
                  </button>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Spec panel — grows to fill remaining height, button pinned to bottom */}
        <div class="border border-smoke p-6 flex flex-col flex-1">
          <div class="eyebrow text-ash mb-4"><T en="Selected configuration" ja="選択中の仕様" /></div>
          <div class="space-y-3 text-sm mb-6 flex-1">
            <div class="flex justify-between gap-4 border-b border-smoke pb-2">
              <span class="text-ash"><T en="Size" ja="サイズ" /></span>
              <span class="font-medium text-right" data-config-display="size">{product.sizes[0].replace('x', '×')}</span>
            </div>
            <div class="flex justify-between gap-4 border-b border-smoke pb-2">
              <span class="text-ash"><T en="Finish" ja="仕上げ" /></span>
              <span class="font-medium text-right" data-config-display="finish"><T en={product.finishes[0]} ja={opt(product.finishes[0])} /></span>
            </div>
            {initialEdgeDetail && (
              <div class="flex justify-between gap-4 border-b border-smoke pb-2">
                <span class="text-ash"><T en="Edge Detail" ja="エッジ形状" /></span>
                <span class="font-medium text-right" data-config-display="edge-detail"><T en={initialEdgeDetail} ja={opt(initialEdgeDetail)} /></span>
              </div>
            )}
            {showColors && (
              <div class="flex justify-between gap-4 border-b border-smoke pb-2">
                <span class="text-ash"><T en={colorLabel} ja={colorLabelJa} /></span>
                <span class="font-medium text-right" data-config-display="color"><T en={product.colors[0]} ja={opt(product.colors[0])} /></span>
              </div>
            )}
            <div class={`flex justify-between gap-4${product.warranty ? ' border-b border-smoke pb-2' : ''}`}>
              <span class="text-ash"><T en="Lengths" ja="長さ" /></span>
              <span class="font-medium text-right">{product.lengths}</span>
            </div>
            {product.warranty && (
              <div class="flex justify-between gap-4">
                <span class="text-ash"><T en="Warranty" ja="保証" /></span>
                <span class={`font-medium text-right ${accentClass}`}><T en={product.warranty} ja={warrantyJa} /></span>
              </div>
            )}
          </div>
          <a
            href="/contact"
            class={`mt-auto block ${accentBg} text-bone text-center py-3 text-sm font-medium hover:opacity-85 transition-opacity`}
          >
            <T en="Request this spec →" ja="この仕様で問い合わせる →" />
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .config-btn {
    background: transparent;
    border-color: var(--smoke);
    color: var(--bone);
    cursor: pointer;
  }
  .config-btn:hover { border-color: var(--bone); }
  .config-btn.is-active {
    background: var(--bone);
    border-color: var(--bone);
    color: var(--ink);
  }

  .photo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.35);
    transition: background 0.3s;
  }
  .photo-dot.is-active { background: rgba(255,255,255,0.9); }
</style>

<script>
  // ─────────────────────────────────────────────────────────────────────────
  // Constants
  // ─────────────────────────────────────────────────────────────────────────

  const MAX_NUMBERED   = 8;    // max numbered shots per combo (_1 … _8)
  const SLIDE_INTERVAL = 4500; // ms each photo is shown before crossfading
  const FADE_MS        = 450;  // must match the CSS transition above

  // ─────────────────────────────────────────────────────────────────────────
  // DOM refs
  // ─────────────────────────────────────────────────────────────────────────

  const configData       = document.getElementById('product-config-data');
  // [0] = this product's photos, [1] = its Hollow/Solid twin's (if any)
  const photoSets        = JSON.parse(configData?.dataset.photoSets ?? '[]') as Array<{ base: string; files: string[] }>;
  const allSizes         = JSON.parse(configData?.dataset.sizes    ?? '[]') as string[];
  const allFinishes      = JSON.parse(configData?.dataset.finishes ?? '[]') as string[];
  const allColors        = JSON.parse(configData?.dataset.colors   ?? '[]') as string[];
  const EDGE_JA          = JSON.parse(configData?.dataset.edgeJa   ?? '{}') as Record<string, string>;
  const photoImg         = document.getElementById('product-photo')      as HTMLImageElement | null;
  const photoPlaceholder = document.getElementById('photo-placeholder')  as HTMLElement | null;
  const dotsEl           = document.getElementById('photo-dots')         as HTMLElement | null;

  // ─────────────────────────────────────────────────────────────────────────
  // Slideshow state
  // ─────────────────────────────────────────────────────────────────────────

  let cyclePhotos: string[]   = [];
  let cycleIdx                = 0;
  let cycleTimer: ReturnType<typeof setInterval> | null = null;

  // ─────────────────────────────────────────────────────────────────────────
  // Helpers
  // ─────────────────────────────────────────────────────────────────────────

  const FINISH_EDGE_DETAIL = JSON.parse(configData?.dataset.finishEdges ?? '{}') as Record<string, string>;

  /** "Rougher Head" → "Rougher-Head" */
  function toFile(s: string): string {
    return s.replace(/\s+/g, '-');
  }

  /** URL of name.jpg (preferred) or name.png in a photo set, or null */
  function find(set: { base: string; files: string[] }, name: string): string | null {
    if (set.files.includes(name + '.jpg')) return set.base + name + '.jpg';
    if (set.files.includes(name + '.png')) return set.base + name + '.png';
    return null;
  }

  /** Single-image names to try (most specific → least specific, no extension) */
  function fallbackNames(s: string, f: string, c: string): string[] {
    const list: string[] = [];
    if (s && f && c) list.push(`${s}_${f}_${c}`);
    if (f && c)      list.push(`${f}_${c}`);
    if (c)           list.push(c);
    if (s && f)      list.push(`${s}_${f}`);
    return list;
  }

  /** The Size_Finish_Colour_N photo in a set that best matches the selection
   *  (colour counts most, then finish, then size; _1 shots win ties) */
  function closest(set: { base: string; files: string[] }, s: string, f: string, c: string): string | null {
    let best: { url: string; score: number } | null = null;
    for (const file of set.files) {
      const parts = file.replace(/\.(jpe?g|png)$/i, '').split('_');
      if (parts.length !== 4 || !/^\d+$/.test(parts[3])) continue;
      const [ps, pf, pc, pn] = parts;
      const score = (pc === c ? 8 : 0) + (pf === f ? 4 : 0) + (ps === s ? 2 : 0) + (pn === '1' ? 1 : 0);
      const url = find(set, parts.join('_')); // jpg wins over a png of the same name
      if (url && (!best || score > best.score)) best = { url, score };
    }
    return best?.url ?? null;
  }

  // ─────────────────────────────────────────────────────────────────────────
  // Dot indicators
  // ─────────────────────────────────────────────────────────────────────────

  function buildDots(count: number) {
    if (!dotsEl) return;
    dotsEl.innerHTML = '';
    if (count < 2) { dotsEl.classList.add('hidden'); return; }
    dotsEl.classList.remove('hidden');
    for (let i = 0; i < count; i++) {
      const dot = document.createElement('div');
      dot.className = `photo-dot${i === 0 ? ' is-active' : ''}`;
      dotsEl.appendChild(dot);
    }
  }

  function updateDot(idx: number) {
    if (!dotsEl) return;
    dotsEl.querySelectorAll('.photo-dot').forEach((d, i) => {
      d.classList.toggle('is-active', i === idx);
    });
  }

  // ─────────────────────────────────────────────────────────────────────────
  // Photo display
  // ─────────────────────────────────────────────────────────────────────────

  function stopCycle() {
    if (cycleTimer) { clearInterval(cycleTimer); cycleTimer = null; }
  }

  /** Swap to a new src with crossfade; calls back when the image is visible */
  function crossfadeTo(src: string, onVisible?: () => void) {
    if (!photoImg) return;
    photoImg.style.opacity = '0';
    setTimeout(() => {
      photoImg!.src = src;
      photoImg!.onload = () => {
        photoImg!.style.opacity = '1';
        if (photoPlaceholder) photoPlaceholder.style.display = 'none';
        onVisible?.();
      };
    }, FADE_MS);
  }

  /** Display a set of photos and start cycling if more than one */
  function startCycle(photos: string[]) {
    stopCycle();
    cyclePhotos = photos;
    cycleIdx    = 0;

    buildDots(photos.length);

    crossfadeTo(photos[0]);

    if (photos.length > 1) {
      cycleTimer = setInterval(() => {
        cycleIdx = (cycleIdx + 1) % cyclePhotos.length;
        updateDot(cycleIdx);
        crossfadeTo(cyclePhotos[cycleIdx]);
      }, SLIDE_INTERVAL);
    }
  }

  // ─────────────────────────────────────────────────────────────────────────
  // Main load function
  // ─────────────────────────────────────────────────────────────────────────

  const selections: Record<string, string> = {};

  function loadPhotosForSelection() {
    stopCycle();
    if (photoImg) photoImg.style.opacity = '0';

    const s = toFile(selections.size   ?? '');
    const f = toFile(selections.finish ?? '');
    const c = toFile(selections.color  ?? '');
    const own = photoSets[0] ?? { base: '', files: [] };

    // ── 1. This exact option's numbered shots (_1 … _8), cycled ─────────────
    const key = [s, f, c].filter(Boolean).join('_');
    const numbered = key
      ? Array.from({ length: MAX_NUMBERED }, (_, i) => find(own, `${key}_${i + 1}`)).filter((u): u is string => !!u)
      : [];
    if (numbered.length) return startCycle(numbered);

    // ── 2. Single-image names for this option ───────────────────────────────
    for (const name of fallbackNames(s, f, c)) {
      const url = find(own, name);
      if (url) return startCycle([url]);
    }

    // ── 3. Closest photo of this product, then its general shot; then the same
    //       from its Hollow/Solid twin — so the panel is never blank while any
    //       photo exists in the family ──────────────────────────────────────
    for (const set of photoSets) {
      const url = closest(set, s, f, c) ?? find(set, 'default');
      if (url) return startCycle([url]);
    }

    // ── Nothing at all — show placeholder ─────────────────────────────────
    buildDots(0);
    if (photoPlaceholder) photoPlaceholder.style.display = '';
  }

  // ─────────────────────────────────────────────────────────────────────────
  // Wire up toggle groups
  // ─────────────────────────────────────────────────────────────────────────

  document.querySelectorAll('[data-config-group]').forEach((group) => {
    const groupName = group.getAttribute('data-config-group')!;
    const display   = document.querySelector(`[data-config-display="${groupName}"]`);
    const buttons   = group.querySelectorAll('.config-btn');

    // Seed from the initially-active button
    const active = group.querySelector('.config-btn.is-active') as HTMLButtonElement | null;
    if (active) selections[groupName] = active.dataset.configOption ?? '';

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const value = (btn as HTMLButtonElement).dataset.configOption ?? '';
        selections[groupName] = value;
        // Button holds both languages (see T.astro) — copy it across as-is
        if (display) display.innerHTML = btn.innerHTML;

        // Update edge detail label when finish changes
        if (groupName === 'finish') {
          const edgeDisplay = document.querySelector('[data-config-display="edge-detail"]') as HTMLElement | null;
          if (edgeDisplay) {
            const en = FINISH_EDGE_DETAIL[value] ?? '';
            const ja = EDGE_JA[en] ?? en;
            edgeDisplay.innerHTML = '';
            const enSpan = document.createElement('span');
            enSpan.className = 'i18n-en';
            enSpan.textContent = en;
            const jaSpan = document.createElement('span');
            jaSpan.className = 'i18n-ja';
            jaSpan.lang = 'ja';
            jaSpan.textContent = ja;
            edgeDisplay.append(enSpan, jaSpan);
            (edgeDisplay.parentElement as HTMLElement).style.display = en ? '' : 'none';
          }
        }

        loadPhotosForSelection();
      });
    });
  });

  // For products where a group has no rendered buttons (e.g. single-color products
  // where the color selector is hidden), the selections object never gets seeded for
  // that group. Fill in the first value from the data arrays as a fallback.
  if (!selections.color  && allColors.length  > 0) selections.color  = allColors[0];
  if (!selections.finish && allFinishes.length > 0) selections.finish = allFinishes[0];
  if (!selections.size   && allSizes.length   > 0) selections.size   = allSizes[0];

  // Kick off the initial photo load
  loadPhotosForSelection();
</script>
