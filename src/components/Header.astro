---
import T from './T.astro';

const nav = [
  { label: 'Products', ja: '製品', href: '/products' },
  { label: 'Technical', ja: '技術情報', href: '/technical' },
  { label: 'Sustainability', ja: 'サステナビリティ', href: '/sustainability' },
  { label: 'Contact', ja: 'お問い合わせ', href: '/contact' },
];
---

<header class="border-b border-line">
  <div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 28" class="h-7 w-auto flex-shrink-0" aria-hidden="true">
        <!-- Large black square with hollow core -->
        <rect x="0" y="0" width="21" height="21" fill="#0A0A0A"/>
        <rect x="6" y="6" width="9" height="9" fill="#FAFAF7"/>
        <!-- Orange square with hollow core -->
        <rect x="12" y="8" width="18" height="18" fill="#D4451F"/>
        <rect x="17.5" y="14" width="7" height="7" fill="#FAFAF7"/>
      </svg>
      <span class="text-2xl font-medium tracking-tightest">SEAMLESS<sup class="text-[10px] font-normal align-super">™</sup></span>
    </a>
    <div class="flex items-center gap-5 lg:gap-7">
      <nav class="hidden md:flex items-center gap-5 lg:gap-7">
        {nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ink hover:text-cedar transition-colors"
          >
            <T en={item.label} ja={item.ja} />
          </a>
        ))}
        <a
          href="/substitution"
          class="text-sm font-medium text-cedar bg-cedar/10 px-4 py-2 hover:bg-cedar hover:text-bone transition-colors"
        >
          <T en="Request Product Substitution" ja="製品代替のご依頼" />
        </a>
      </nav>
      <!-- Language toggle — shows the language you'd switch TO -->
      <button
        type="button"
        data-lang-toggle
        class="inline-flex items-center gap-1.5 border border-ink px-3 py-1.5 text-sm font-medium text-ink hover:bg-ink hover:text-bone transition-colors"
        aria-label="Switch language / 言語を切り替える"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
        </svg>
        <span class="i18n-en" lang="ja">日本語</span><span class="i18n-ja" lang="en">English</span>
      </button>
    </div>
  </div>
</header>
